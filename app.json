{
  "expo": {
    "name": "Estou Dentro",
    "slug": "estou-dentro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "estoudentro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.paulodiney.estoudentro",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.paulodiney.estoudentro",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Estou Dentro precisa acessar suas fotos para você escolher a foto do seu perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Estou Dentro usa sua localização para mostrar os bicos que você publica para quem está por perto."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E5FCC",
          "defaultChannel": "default"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bff999aa-c87a-436e-ac27-5d5b62870879"
      }
    }
  }
}
